@baseUrl = http://localhost:3001/api
@customerToken = replace_with_customer_access_token
@staffToken = replace_with_staff_access_token
@adminToken = replace_with_admin_access_token
@quotationId = replace_with_quotation_uuid
@locationId = replace_with_location_uuid
@industryId = replace_with_industry_uuid
@serviceId = replace_with_service_uuid

### Public pricing calculation
POST {{baseUrl}}/public/quotations/calculate
Content-Type: application/json

{
  "workerCount": 10,
  "locationId": "{{locationId}}",
  "industryId": "{{industryId}}",
  "serviceIds": ["{{serviceId}}"]
}

### Customer: save quotation
POST {{baseUrl}}/customers/me/quotations
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "workerCount": 10,
  "locationId": "{{locationId}}",
  "industryId": "{{industryId}}",
  "serviceIds": ["{{serviceId}}"]
}

### Customer: quotation history
GET {{baseUrl}}/customers/me/quotations
Authorization: Bearer {{customerToken}}

### Customer: quotation detail
GET {{baseUrl}}/customers/me/quotations/{{quotationId}}
Authorization: Bearer {{customerToken}}

### Customer: accept quotation
POST {{baseUrl}}/customers/me/quotations/{{quotationId}}/accept
Authorization: Bearer {{customerToken}}

### Customer: reject quotation
POST {{baseUrl}}/customers/me/quotations/{{quotationId}}/reject
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "reason": "Customer requested a revised scope"
}

### Staff: quotation queue
GET {{baseUrl}}/agent/quotations
Authorization: Bearer {{staffToken}}

### Staff: quotation detail
GET {{baseUrl}}/agent/quotations/{{quotationId}}
Authorization: Bearer {{staffToken}}

### Staff: move quotation to review
PATCH {{baseUrl}}/agent/quotations/{{quotationId}}/status
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "status": "under_review",
  "note": "Initial staff review"
}

### Admin: quotation queue
GET {{baseUrl}}/admin/quotations
Authorization: Bearer {{adminToken}}

### Admin: send quotation
PATCH {{baseUrl}}/admin/quotations/{{quotationId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "sent",
  "note": "Ready for customer review"
}

### Admin: quotation history
GET {{baseUrl}}/admin/quotations/{{quotationId}}/history
Authorization: Bearer {{adminToken}}

### Authenticated quotation detail
GET {{baseUrl}}/quotations/{{quotationId}}
Authorization: Bearer {{customerToken}}

### Authenticated quotation PDF
GET {{baseUrl}}/quotations/{{quotationId}}/pdf
Authorization: Bearer {{customerToken}}
