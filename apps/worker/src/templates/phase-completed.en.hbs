{{#> layout}}
  <h1 style="font-size:20px; margin:0 0 12px;">A phase was completed</h1>
  <p style="margin:0 0 12px;">Good news — a phase of your document <strong>{{documentName}}</strong> has been completed.</p>
  <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 16px;">
    <tr><td style="padding:4px 0; color:#64748b;">Phase</td><td style="padding:4px 0 4px 16px;"><strong>{{phaseName}}</strong></td></tr>
    <tr><td style="padding:4px 0; color:#64748b;">Progress</td><td style="padding:4px 0 4px 16px;"><strong>{{progressPercent}}%</strong></td></tr>
  </table>
  {{#if note}}<p style="margin:0 0 16px; padding:12px; background:#f1f5f9; border-radius:6px;">{{note}}</p>{{/if}}
  <p style="margin:0 0 20px;"><a href="{{portalUrl}}" style="background:#0f172a; color:#ffffff; padding:10px 18px; border-radius:6px; text-decoration:none;">View your document</a></p>
{{/layout}}
