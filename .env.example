# ============================================================================
# Template. Copy to .env and fill in real values:  cp .env.example .env
#
# Docker Compose reads .env for ${VAR} interpolation in compose.yml, and
# `env_file: .env` injects the same values into the api and worker containers.
# Values in a service's `environment:` block override anything here.
#
# Never commit a filled-in .env — it is gitignored for a reason.
# ============================================================================

# --- App --------------------------------------------------------------------
# development | test | production
NODE_ENV=production
PORT=3001
API_PORT=3001
API_URL=https://api.yourdomain.com

# Comma-separated list of allowed browser origins.
# Required in production, and "*" is rejected — the API refuses to boot on either.
CORS_ORIGIN=https://yourdomain.com

# Base URL of the browser app. Every link inside an outgoing email is built from
# it (password reset, document status, quotation, invoice). Required in production:
# unset, the links come out as bare relative paths and are unclickable in a mail
# client. Falls back to the first CORS_ORIGIN entry when unset outside production.
WEB_URL=https://yourdomain.com

# --- JWT --------------------------------------------------------------------
# Generate each one separately, never reuse the same value for both:
#   openssl rand -hex 32
# Minimum 32 characters. In production the two must differ.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Postgres ---------------------------------------------------------------
# Compose builds the container-side DATABASE_URL from these parts.
DB_USER=
DB_PASS=
DB_NAME=construction_db

# Host publish port, used by compose.yml in development only — compose.prod.yml
# does not publish Postgres at all. Keep it off 5432: Windows reserves TCP blocks
# for Hyper-V/WSL, and a locally installed PostgreSQL occupies the default port.
DB_PORT=15432

# Used by host-side tooling (npm run db:migrate) and by non-Docker deployments.
# Inside Compose this is overridden to use the `postgres` service hostname, so
# the port here must match DB_PORT above, not the container's 5432.
DATABASE_URL=postgres://user:pass@localhost:15432/construction_db

# --- Redis ------------------------------------------------------------------
# Host publish port, development only. See DB_PORT.
REDIS_PORT=16379
# Overridden inside Compose to use the `redis` service hostname.
REDIS_URL=redis://localhost:16379

# --- AWS --------------------------------------------------------------------
# Leave empty to fall back to local disk storage and skip SES delivery.
# Credentials come from the IAM instance role in production, not from this file.
AWS_REGION=ap-south-1
# Private bucket for customer documents. Served only through presigned URLs; keep
# Block Public Access ON. Never make this bucket or its objects public.
S3_BUCKET=
# PUBLIC bucket for website/CMS images only (hero slides, service & package images).
# Served to anonymous visitors as plain URLs, so it allows public read via a bucket
# policy (see docs/s3-public-bucket-setup.md). Must contain NO customer documents.
# Leave empty to keep images in S3_BUCKET (pre-separation behaviour).
S3_PUBLIC_BUCKET=
S3_BACKUP_BUCKET=
MAIL_FROM=no-reply@yourdomain.com
SES_CONFIGURATION_SET=transactional-prod
# Use separate SES credentials from the S3 user when running outside an IAM role.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# --- CMS on-demand revalidation ---------------------------------------------
# After any homepage CMS change (hero slides / site content / settings) the API
# fires a signed webhook so the customer-portal re-renders immediately. Both are
# optional: unset, the CMS still works and simply skips the ping.
#   PORTAL_REVALIDATE_URL — the portal's endpoint, e.g. https://yourdomain.com/api/revalidate
#   CMS_REVALIDATE_SECRET — shared HMAC secret; set the SAME value in the portal's env.
#                           Generate with: openssl rand -hex 32  (min 16 chars)
PORTAL_REVALIDATE_URL=
CMS_REVALIDATE_SECRET=
